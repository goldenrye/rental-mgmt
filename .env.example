DATABASE_URL=sqlite:///./data/rental_mgmt.db
# scripts/init_env.py replaces this placeholder with a random key; the app rejects the placeholder.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial password for the 'admin' account, at least 12 characters. Leave empty to have
# a random one generated and printed once to the API log.
SUPER_ADMIN_INITIAL_PASSWORD=

# true lets anyone register a landlord or tenant without an invitation. Local development only.
OPEN_REGISTRATION=false

# true reads the client IP from nginx's X-Real-IP. Enable only when the API is reachable
# solely through nginx (docker-compose.prod.yml sets it).
TRUST_PROXY_HEADERS=false
