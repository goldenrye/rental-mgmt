DATABASE_URL=sqlite:///./data/rental_mgmt.db
# scripts/init_env.py replaces this placeholder with a random key; the app rejects the placeholder.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
# Separate from JWT signing. Empty uses .secrets/data-encryption.key for local development.
# Run python -m scripts.manage_encryption init-key once; NEVER replace a key for an existing DB.
DATA_ENCRYPTION_MASTER_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial password for the 'admin' account, at least 12 characters. Leave empty to have
# a random one generated and printed once to the API log.
SUPER_ADMIN_INITIAL_PASSWORD=

# true lets anyone register a landlord or tenant without an invitation. Local development only.
OPEN_REGISTRATION=false

# true reads the client IP from nginx's X-Real-IP. Enable only when the API is reachable
# solely through nginx (docker-compose.prod.yml sets it).
TRUST_PROXY_HEADERS=false

# Optional Google Calendar export. Empty values keep the integration unavailable;
# each landlord must connect and explicitly enable it (off by default).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact URI on a Google OAuth "Web application" client.
# Local: http://localhost:8000/google-calendar/callback
# Production: https://your-domain/api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Public website URL used in exported events and on the OAuth completion page.
GOOGLE_CALENDAR_APP_URL=

# Optional browser push reminders for lease ends and bill due dates. Empty values keep
# them unavailable; each landlord turns them on per device in Edit Profile.
# Generate once with: python -m scripts.generate_vapid_key (rotating it drops all subscriptions)
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:admin@your-domain
WEB_PUSH_CONTACT=

# Optional iPhone app reminders through Apple Push Notification service (APNs).
# Create a key with APNs enabled under Apple Developer > Certificates, IDs & Profiles > Keys.
# One key serves both Xcode debug (sandbox) and TestFlight/App Store (production) builds.
APNS_TEAM_ID=
APNS_KEY_ID=
# The app's bundle identifier (appId in frontend/capacitor.config.ts)
APNS_TOPIC=
# Put the downloaded AuthKey_XXXX.p8 in .secrets/ (mounted at /run/secrets), e.g.
# APNS_AUTH_KEY_FILE=/run/secrets/apns-auth-key.p8, or paste it inline as APNS_AUTH_KEY.
APNS_AUTH_KEY_FILE=
APNS_AUTH_KEY=

# Optional "Forgot password" emails. Empty SMTP_HOST or SMTP_FROM keeps it unavailable;
# the administrator can still reset landlord passwords from the admin dashboard.
# Port 465 uses implicit TLS; other ports use STARTTLS unless SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Sender address, e.g. Rental Management <no-reply@your-domain>
SMTP_FROM=
# Public website URL used in reset links, e.g. https://your-domain (falls back to GOOGLE_CALENDAR_APP_URL)
APP_URL=

# Optional passkey sign-in. Keep the RP hostname stable; changing it invalidates existing passkeys.
# Example: PASSKEY_RP_ID=rent.example.com
# Exact comma-separated HTTPS origins (no trailing slash), e.g. https://rent.example.com
PASSKEY_RP_ID=
PASSKEY_ORIGINS=
# Native iOS: App ID prefix (usually Apple Team ID) + "." + bundle ID.
# Example: ABCDE12345.com.jpi.rental-mgmt. Also add webcredentials:<RP hostname> in Xcode.
PASSKEY_APPLE_APP_IDS=
